Allow PREEMPT_NONE on ARCH_HAS_PREEMPT_LAZY arches (x86) for server builds.
Only the static model; preempt=none via PREEMPT_DYNAMIC stays unavailable.

--- a/kernel/Kconfig.preempt	2026-10-22 23:05:58
+++ b/kernel/Kconfig.preempt	2026-10-22 23:05:58
@@ -22,7 +22,6 @@
 config PREEMPT_NONE
 	bool "No Forced Preemption (Server)"
 	depends on !PREEMPT_RT
-	depends on ARCH_NO_PREEMPT
 	select PREEMPT_NONE_BUILD if !PREEMPT_DYNAMIC
 	help
 	  This is the traditional Linux preemption model, geared towards
